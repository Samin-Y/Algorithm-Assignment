<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.canvas.Canvas?>

<?import java.net.URL?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.graphprompt.controller.MainController" styleClass="root">
    <stylesheets>
        <URL value="@style.css"/>
    </stylesheets>
    <top>
        <VBox spacing="15" style="-fx-padding: 20;">
            <Label text="Dynamic Knowledge Graph Retrieval (Graph-to-Prompt Engine)" styleClass="title-label"/>
            
            <HBox spacing="12">
                <Button text="Show Conversation" fx:id="btnShowConv" onAction="#handleShowConversation"/>
                <Button text="Ingest Mock Data" fx:id="btnIngest" onAction="#handleIngest"/>
                <Button text="Run Dijkstra" fx:id="btnDijkstra" onAction="#handleDijkstra"/>
                <Button text="Run BFS" fx:id="btnBFS" onAction="#handleBFS"/>
                <Button text="Assemble Prompt (Knapsack DP)" fx:id="btnDP" onAction="#handleDP"/>
                <Button text="Assemble Prompt (Greedy)" fx:id="btnGreedy" onAction="#handleGreedy"/>
            </HBox>
            
            <HBox spacing="15" alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Label text="Token Budget (B):"/>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Slider fx:id="sliderBudget" min="10" max="500" value="50" prefWidth="120" showTickLabels="false" showTickMarks="false"/>
                        <TextField fx:id="txtBudget" text="50" prefWidth="60"/>
                    </HBox>
                </VBox>
                
                <VBox spacing="5">
                    <Label text="Alpha (Freq):"/>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Slider fx:id="sliderAlpha" min="0" max="1" value="0.5" prefWidth="120"/>
                        <TextField fx:id="txtAlpha" text="0.5" prefWidth="60"/>
                    </HBox>
                </VBox>
                
                <VBox spacing="5">
                    <Label text="Beta (Recency):"/>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Slider fx:id="sliderBeta" min="0" max="1" value="0.5" prefWidth="120"/>
                        <TextField fx:id="txtBeta" text="0.5" prefWidth="60"/>
                    </HBox>
                </VBox>
                
                <VBox spacing="5">
                    <Label text="Gamma (Degree):"/>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Slider fx:id="sliderGamma" min="0" max="1" value="0.5" prefWidth="120"/>
                        <TextField fx:id="txtGamma" text="0.5" prefWidth="60"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <VBox style="-fx-padding: 0 20 10 20;">
            <Pane fx:id="canvasPane" styleClass="canvas-pane" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
    
    <bottom>
        <VBox spacing="10" style="-fx-padding: 10 20 20 20;">
            <Label text="Output Console" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <TextArea fx:id="consoleOutput" editable="false" prefRowCount="8" styleClass="text-area"/>
        </VBox>
    </bottom>
</BorderPane>
